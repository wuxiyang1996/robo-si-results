      "success": false
    },
    {
      "family": "MR",
      "C": 10,
      "H": 8,
      "N": 10,
      "P": 3,
      "M": 4,
      "R_end": 0,
      "expected_score": 83,
      "success": false
    },
    {
      "family": "MR",
      "C": 10,
      "H": 10,
      "N": 10,
      "P": 4,
      "M": 4,
      "R_end": 1,
      "expected_score": 100,
      "success": true
    },
    {
      "family": "MR",
      "C": 10,
      "H": 10,
      "N": 10,
      "P": 4,
      "M": 4,
      "R_end": 1,
      "void": true,
      "expected_score": 0,
      "success": false
    }
  ],
  "hierarchy_validation": [
    "HL_LL_temporal_dependencies_and_shot_identity",
    "LL_TRAJ_bounded_actuation_support_transitions_time_coverage",
    "HL_TRAJ_independent_motion_rally_prefix_recovery"
  ],
  "enabling_gate": "continuous normal-reset physical witness, independent regrade, fresh action replay, negative fixtures, calibrated thresholds; no current execution claim",
  "publication_approved": true,
  "release_url": "https://github.com/wuxiyang1996/robo-si/releases/tag/table-tennis-0.1.0",
  "approval_record": "../publication/approval.json"
}
